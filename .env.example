DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Keep this stable once encrypted bank data exists. If existing data was
# encrypted while this was unset, preserve the SECRET_KEY that encrypted it.
BANK_DATA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
DEBUG=True
USE_SQLITE=True
PAYMENT_PROVIDER=mock
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Optional map tile overrides; these match the defaults in Django settings.
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_FALLBACK_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png

# Docker Compose overrides USE_SQLITE and DB_HOST for its MySQL container.
# For local MySQL outside Docker, use USE_SQLITE=False and DB_HOST=127.0.0.1.
DB_NAME=food_ex
DB_USER=food_ex_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=db
DB_PORT=3306
DOCKER_DB_USER=food_ex_user
DOCKER_DB_PASSWORD=replace-with-a-docker-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-mysql-root-password

# For separate deployed frontends, list exact origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://food.example.com,https://restaurant.example.com,https://delivery.example.com
# CSRF_TRUSTED_ORIGINS=https://food.example.com,https://restaurant.example.com,https://delivery.example.com
# ALLOWED_HOSTS=food.example.com,restaurant.example.com,delivery.example.com
